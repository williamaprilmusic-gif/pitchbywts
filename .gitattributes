# Enforce LF line endings so the prepare-*.mjs build scripts (which anchor on
# LF "\n" when matching source text) work on every platform, including Windows.
* text=auto eol=lf

*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.webmanifest text eol=lf

# Binary assets must not be normalised.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
